<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Reportes Mensuales" android:textSize="22sp" android:textStyle="bold" />

        <View android:layout_width="match_parent" android:layout_height="200dp"
            android:background="#EEEEEE" android:layout_marginVertical="20dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Resumen de gastos por categoría" android:textAlignment="center" />
    </LinearLayout>
</ScrollView>