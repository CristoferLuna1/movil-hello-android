<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Historial de Movimientos" android:textSize="22sp"
        android:textStyle="bold" android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_transactions"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/layout_empty_state" android:id="@+id/empty_view" android:visibility="gone" />
</LinearLayout>