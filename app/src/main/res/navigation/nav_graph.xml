<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- HOME -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.helloandroidcristofermunoz.ui.home.HomeFragment"
        android:label="Home">

        <action
            android:id="@+id/action_homeFragment_to_transactionDetailFragment"
            app:destination="@id/transactionDetailFragment" />
    </fragment>

    <!-- ADD -->
    <fragment
        android:id="@+id/addTransactionFragment"
        android:name="com.example.helloandroidcristofermunoz.ui.addtransaction.AddTransactionFragment"
        android:label="Add" />

    <!-- STATISTICS -->
    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.example.helloandroidcristofermunoz.ui.statistics.StatisticsFragment"
        android:label="Statistics" />

    <!-- PROFILE -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.helloandroidcristofermunoz.ui.profile.ProfileFragment"
        android:label="Profile">

        <action
            android:id="@+id/action_profileFragment_to_historyFragment"
            app:destination="@id/historyFragment"
            app:popUpTo="@id/profileFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <!-- HISTORY -->
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.helloandroidcristofermunoz.ui.history.HistoryFragment"
        android:label="History">

        <argument
            android:name="fromProfile"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <!-- DETAIL (CLAVE) -->
    <fragment
        android:id="@+id/transactionDetailFragment"
        android:name="com.example.helloandroidcristofermunoz.ui.detail.TransactionDetailFragment"
        android:label="Detail">

        <argument
            android:name="transactionId"
            app:argType="integer" />
    </fragment>

</navigation>