<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/movieListFragment">

    <fragment
        android:id="@+id/movieListFragment"
        android:name="com.example.helloandroidcristofermunoz.ui.MovieListFragment">

        <action
            android:id="@+id/action_list_to_detail"
            app:destination="@id/movieDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/movieDetailFragment"
        android:name="com.example.helloandroidcristofermunoz.ui.MovieDetailFragment">

        <argument
            android:name="movieTitle"
            app:argType="string" />

        <action
            android:id="@+id/action_detail_to_edit"
            app:destination="@id/movieEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/movieEditFragment"
        android:name="com.example.helloandroidcristofermunoz.ui.MovieEditFragment"/>
</navigation>